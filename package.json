{
  "name": "contour",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/tone-adapter",
    "packages/mcp-server",
    "packages/playground",
    "packages/plugins/audio",
    "packages/plugins/midi",
    "examples/bach-invention-4",
    "examples/live-coding-demo",
    "examples/advanced-effects-demo",
    "examples/lofi-chill",
    "examples/sample-library-demo"
  ],
  "scripts": {
    "build": "bun run build:core && bun run build:tone && bun run build:plugins && bun run build:mcp && bun run build:playground",
    "build:core": "cd packages/core && bun run build",
    "build:tone": "cd packages/tone-adapter && bun run build",
    "build:plugins": "cd packages/plugins/audio && bun run build && cd ../midi && bun run build",
    "build:mcp": "cd packages/mcp-server && bun run build",
    "build:playground": "cd packages/playground && bun run build",
    "test": "bun run test:core && bun run test:tone && bun run test:plugins && bun run test:mcp",
    "test:core": "cd packages/core && bun run test",
    "test:tone": "cd packages/tone-adapter && bun run test",
    "test:plugins": "cd packages/plugins/audio && bun run test && cd ../midi && bun run test",
    "test:mcp": "cd packages/mcp-server && bun run test",
    "type-check": "bun run typecheck:core && bun run typecheck:tone && bun run typecheck:mcp",
    "typecheck:core": "cd packages/core && bun run type-check",
    "typecheck:tone": "cd packages/tone-adapter && bun run type-check",
    "typecheck:mcp": "cd packages/mcp-server && bun run type-check",
    "lint": "eslint packages/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
