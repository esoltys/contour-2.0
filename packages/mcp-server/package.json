{
  "name": "@contour/mcp-server",
  "version": "2.0.0",
  "type": "module",
  "description": "MCP servers for Contour music composition system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "contour-mcp": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "tsc && pnpm bundle",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=dist/cli.cjs --format=cjs --external:@modelcontextprotocol/sdk",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "start": "node dist/cli.cjs"
  },
  "dependencies": {
    "@contour/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": ["mcp", "music", "contour", "composition", "claude"]
}
