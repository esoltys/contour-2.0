{
  "name": "@contour/mcp-server",
  "version": "2.0.0",
  "type": "module",
  "description": "MCP servers for Contour music composition system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "contour-mcp": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "tsc && bun build ./src/cli.ts --outfile=dist/cli.cjs --target=node",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "start": "node dist/cli.cjs"
  },
  "dependencies": {
    "@contour/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "keywords": ["mcp", "music", "contour", "composition", "claude"]
}
